# APPLICATION CONFIGURATION
APP_ENV=development
DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=5000
LOG_LEVEL=INFO
MAX_WORKERS=4

# WHATSAPP CONFIGURATION
WHATSAPP_PROVIDER=evolution
# Options: 'twilio' or 'evolution'

# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=whatsapp-scanner

# WhatsApp Scanning
WEBHOOK_URL=http://localhost:5000/api/v1/webhook
SCAN_INTERVAL=5
MAX_HISTORY_DAYS=30

# MARIADB CONFIGURATION
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=song_scanner
MARIADB_USERNAME=scanner_bot
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme

# REDIS CONFIGURATION
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MUSICBRAINZ CONFIGURATION
MUSICBRAINZ_USER_AGENT=WhatsAppSongScanner/1.0.0
MUSICBRAINZ_RATE_LIMIT=1.0
MUSICBRAINZ_CACHE_HOURS=168

# MUSIC MATCHING
MIN_MATCH_SCORE=85
MAX_CANDIDATES=5

# SPOTIFY (OPTIONAL FALLBACK)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# DEEZER (OPTIONAL FALLBACK)
DEEZER_APP_ID=your_deezer_app_id

# RADIODJ INTEGRATION
RADIODJ_API_URL=http://localhost:8080/radiodj
RADIODJ_API_KEY=your_radiodj_api_key
RADIODJ_DB_PATH=/path/to/radiodj/database.sqlite
RADIODJ_DEFAULT_PLAYLIST_ID=1

# CELERY CONFIGURATION
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# MONITORING
GRAFANA_PASSWORD=admin
