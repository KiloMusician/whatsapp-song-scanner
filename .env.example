# APPLICATION CONFIGURATION
APP_ENV=production
DEBUG=false
APP_PORT=5000
LOG_LEVEL=INFO

# WHATSAPP CONFIGURATION
# Choose provider: 'twilio' or 'evolution'
WHATSAPP_PROVIDER=evolution

# Twilio WhatsApp API (if using Twilio provider)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Evolution API (if using Evolution provider - recommended)
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=whatsapp_instance

# Chat scanning interval (minutes)
SCAN_INTERVAL_MINUTES=5

# MARIADB CONFIGURATION
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=song_scanner
MARIADB_USERNAME=scanner_bot
MARIADB_PASSWORD=your_secure_database_password_here
MARIADB_ROOT_PASSWORD=your_root_password_here

# Connection pooling
MARIADB_POOL_SIZE=5
MARIADB_MAX_OVERFLOW=10

# REDIS CONFIGURATION
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# MUSICBRAINZ CONFIGURATION
MUSICBRAINZ_USER_AGENT=WhatsAppSongScanner/1.0.0
MUSICBRAINZ_RATE_LIMIT=1.0
MUSICBRAINZ_CACHE_DURATION_HOURS=24

# Music matching thresholds
MIN_MATCH_SCORE=85
MAX_CANDIDATES=5
MUSICBRAINZ_FUZZY_MATCH_THRESHOLD=0.75

# SPOTIFY (OPTIONAL FALLBACK)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# DEEZER (OPTIONAL FALLBACK)
DEEZER_APP_ID=your_deezer_app_id

# RADIODJ INTEGRATION
RADIODJ_API_URL=http://localhost:8080/api
RADIODJ_API_KEY=your_radiodj_api_key_here
RADIODJ_DB_PATH=/path/to/radiodj/Database.db
RADIODJ_LIBRARY_PATH=/path/to/your/music/library
RADIODJ_DEFAULT_PLAYLIST_ID=1

# LOGGING
LOG_DIR=data/logs
LOG_RETENTION_DAYS=30

# MONITORING
HEALTH_CHECK_INTERVAL=30
ENABLE_METRICS=true

# DOCKER
COMPOSE_PROJECT_NAME=whatsapp-song-scanner

# DEVELOPMENT (set to false in production)
TESTING=false

# TELEGRAM BOT (optional - used for live match notifications)
# Set these in your local `.env` (do NOT commit secrets)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
